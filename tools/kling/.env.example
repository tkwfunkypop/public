# Kling 公式API の認証情報（このファイルをコピーして .env を作り、値を入れる）
# ※ .env は .gitignore 済み。鍵はチャットに貼らないこと。
KLING_ACCESS_KEY=ここにAccessKey
KLING_SECRET_KEY=ここにSecretKey

# 任意設定
# KLING_MODEL=kling-v2-1
# KLING_BASE_URL=https://api.klingai.com
# KLING_MODE=pro
# KLING_DURATION=5
# KLING_CAMERA=on
# KLING_ZOOM=3
# KLING_OUT=./lp/assets/hero.mp4
