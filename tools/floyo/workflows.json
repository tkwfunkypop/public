{
  "_readme": "endpoint は全ワークフロー共通で https://api.floyo.ai/runs（run.mjs に内蔵）。patches はマニフェストの inputs キー → graphs/<key>.json のノード差し込み位置。upload:true の入力はURLを cdn.floyo.ai/upload に通して input_path 化してから差し込む",
  "qwen-angle": {
    "label": "WFAIA_Camera Angle Control with Qwen",
    "source": "https://www.floyo.ai/~/e7ykyihd/c/camera-angle-control-with-qwen-l3zx6wfadfwk",
    "run_prefix": "wfaia_qwen",
    "patches": {
      "image_url": {
        "node": "41",
        "field": "image",
        "upload": true
      },
      "h_angle": {
        "node": "109",
        "field": "horizontal_angle"
      },
      "v_angle": {
        "node": "109",
